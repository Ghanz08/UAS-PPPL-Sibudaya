# Copy this file to .env.qa4, fill real values, then load it into your shell.
# These names match ConfigLoader env lookup for qa4.* keys.

QA4_ADMIN_IDENTIFIER=admin@example.com
QA4_ADMIN_PASSWORD=password-admin

QA4_LEMBAGA_IDENTIFIER=nik-atau-email-lembaga
QA4_LEMBAGA_PASSWORD=password-lembaga

QA4_TIMELINE_PENGAJUAN_ID=id-pengajuan-riwayat-status
QA4_REVISI_PENGAJUAN_ID=id-pengajuan-direvisi
QA4_SELESAI_PENGAJUAN_ID=id-pengajuan-selesai
QA4_DITOLAK_PENGAJUAN_ID=id-pengajuan-ditolak

# Set true to let automation create missing pengajuan data through UI flows.
QA4_AUTO_CREATE_TEST_DATA=false

# Only set true when testing against an empty database.
QA4_EMPTY_DASHBOARD_ENABLED=false
